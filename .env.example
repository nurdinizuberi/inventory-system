# ---------------------------------------------------------------------------
# Inventory Management System - environment
# ---------------------------------------------------------------------------

# PostgreSQL is required (schema provider is postgresql). For local dev either
# run `docker compose up db` (matches the DSN below) or point this at any
# Postgres instance. On Vercel set DATABASE_URL to your managed Postgres
# (Vercel Postgres / Neon / Supabase).
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Secret used to sign JWTs. In production the app REFUSES to start without a
# strong, unique secret (generate one with `openssl rand -hex 32`). The value
# below is accepted only when NODE_ENV !== production (local dev fallback).
JWT_SECRET="dev-only-change-me-please-0123456789abcdef"
JWT_EXPIRES_IN="12h"

# Currency used across the UI (defaults to TZS)
NEXT_PUBLIC_CURRENCY="TZS"

# Auto-seed the demo dataset on first boot when the database is empty (handy
# for demos/staging). Always set this to "0" on a real production database.
AUTO_SEED="1"