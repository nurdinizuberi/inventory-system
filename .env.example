# ---------------------------------------------------------------------------
# Inventory Management System - environment
# ---------------------------------------------------------------------------

# PostgreSQL is required (schema provider is postgresql). For local dev either
# run `docker compose up db` (matches the DSN below) or point this at any
# Postgres instance. On Vercel set DATABASE_URL to your managed Postgres
# (Vercel Postgres / Neon / Supabase).
DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory?schema=public"

# Secret used to sign JWTs. In production the app REFUSES to start without a
# strong, unique secret (generate one with `openssl rand -hex 32`). The value
# below is accepted only when NODE_ENV !== production (local dev fallback).
JWT_SECRET="dev-only-change-me-please-0123456789abcdef"
JWT_EXPIRES_IN="12h"

# Currency used across the UI (defaults to TZS)
NEXT_PUBLIC_CURRENCY="TZS"

# Auto-seed the demo dataset on first boot when the database is empty (handy
# for demos/staging). Always set this to "0" on a real production database.
AUTO_SEED="1"

# ---------------------------------------------------------------------------
# Optional hardening / production features
# ---------------------------------------------------------------------------

# Canonical public origin used to build absolute links in emails (reset/verify).
# On Vercel you can leave this unset and it falls back to the request Host.
# e.g. https://mindboxafrica.com
NEXT_PUBLIC_APP_URL=""

# When you move off *.vercel.app onto a real apex + wildcard, set the apex
# domain (e.g. "mindboxafrica.com"). The apex/www are then bare (global admin)
# and each <slug>.<APP_BASE_DOMAIN> resolves to a tenant — mirroring Vercel's
# built-in bare-domain handling.
APP_BASE_DOMAIN=""

# --- Email (Resend) ---------------------------------------------------
# EMAIL_PROVIDER defaults to "resend" when RESEND_API_KEY is set, else "console"
# (which just prints the would-be message — handy for local dev).
RESEND_API_KEY=""
EMAIL_FROM="MindBoxAfrica <no-reply@mindboxafrica.vercel.app>"

# Require users to verify their email address before signing in.
REQUIRE_EMAIL_VERIFICATION="0"

# --- Error reporting / structured logging -----------------------------
# JSON structured logs go to stdout/stderr natively. When set, errors are also
# POSTed here (Slack incoming webhook / Zapier / custom endpoint).
ERROR_WEBHOOK_URL=""